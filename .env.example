# Placeholders only. Copy to .env and fill locally; never commit .env.
# Active market-data route: direct FYERS v3, read-only.
# Never commit broker credentials or access tokens.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=
FYERS_ENV_FILE=.env

# Historical OpenAlgo/FYERS qualification only; not an active runtime route.
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_UPSTREAM_PROVIDER=fyers
OPENALGO_ANALYZE_MODE=true
OPENALGO_ALLOW_LIVE_ORDERS=false

# TypeSafe (JEV) - research model API, Sprint 7.
TYPESAFE_API_KEY=

# Local runtime
JEV_LOG_LEVEL=INFO
