# Placeholders only. Copy to .env and fill locally; never commit .env.
# Active market-data route: OpenAlgo, pinned to the FYERS broker connection.
# Never commit the OpenAlgo API key or broker credentials.
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_UPSTREAM_PROVIDER=fyers
OPENALGO_ANALYZE_MODE=true
OPENALGO_ALLOW_LIVE_ORDERS=false

# Direct FYERS values are optional historical qualification inputs only.
# They are not required by the active OpenAlgo-backed runtime.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# TypeSafe (JEV) - research model API, Sprint 7.
TYPESAFE_API_KEY=

# Local runtime
JEV_LOG_LEVEL=INFO
